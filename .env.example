# --- Required ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Optional ---
# Model used by the agent. Defaults to nvidia/nemotron-3.5-lightning:free
# (set in llm.py). Any OpenRouter model id works, e.g.:
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_MODEL=

# Web search for the agent (tavily_search tool). Get a key at https://tavily.com
TAVILY_API_KEY=

# LangSmith tracing (https://smith.langchain.com). Leave empty to disable.
LANGCHAIN_API_KEY=

# Directory the agent works inside (created if missing)
AGENT_WORKDIR=./sandbox

# Skip per-action permission prompts (true/false). Guardrails still apply.
AGENT_AUTO_APPROVE=false

# Load git tools via MCP (true/false). Requires mcp-server-git (in requirements.txt).
AGENT_ENABLE_GIT=false

# Repo the git MCP server operates on. Defaults to AGENT_WORKDIR.
GIT_REPO_PATH=

# Disable all guardrails (true/false). Only for trusted, isolated testing.
AGENT_DISABLE_GUARDRAILS=false
